---
import { eraById } from '../data/eras';

interface Props {
  eraId: string;
  /** リンクにするか（時代ハブへ） */
  link?: boolean;
  showPeriod?: boolean;
}
const { eraId, link = true, showPeriod = false } = Astro.props;
const era = eraById(eraId);
const style = `--ec:var(${era.color})`;
---

{link ? (
  <a class="era-chip" href={`/era/${era.id}/`} style={style}>
    <i></i>{era.name}
    {showPeriod && <span class="period">{era.period}</span>}
  </a>
) : (
  <span class="era-chip" style={style}>
    <i></i>{era.name}
    {showPeriod && <span class="period">{era.period}</span>}
  </span>
)}
