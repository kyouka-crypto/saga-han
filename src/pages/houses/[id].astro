---
import Base from '../../layouts/Base.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import SourceRefs from '../../components/SourceRefs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, render } from 'astro:content';
import { allArticles } from '../../lib/archive';
import { HOUSE_RANKS } from '../../data/houseRanks';

export async function getStaticPaths() {
  const houses = await getCollection('houses');
  return houses.map((h) => ({ params: { id: h.id }, props: { house: h } }));
}

const { house } = Astro.props;
const d = house.data;
const { Content } = await render(house);

const rank = HOUSE_RANKS.find((r) => r.id === d.rank);
const people = (await getCollection('people')).filter((p) => p.data.house?.id === house.id);
const related = (await allArticles()).filter((a) => a.data.houses.some((h) => h.id === house.id));

/** 知行高の推移（chigyo の各点に付いた出典もそのまま出す） */
const chigyo = [...d.chigyo].sort((a, b) => a.year - b.year);
const allRefs = [...d.sourceRefs, ...chigyo.flatMap((c) => c.sourceRefs)];
---

<Base title={d.name} description={d.summary}>
  <article class="inner-narrow ent" data-pagefind-body data-pagefind-filter="種別:家">
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">トップ</a><span class="sep">/</span>
      <a href="/houses/">家と家格</a><span class="sep">/</span>
      <span aria-current="page">{d.name}</span>
    </nav>

    <header class="ent-head">
      <h1>{d.name}<span class="rd">{d.reading}</span></h1>
      <p class="ent-meta">
        {rank && <span class="tag">{rank.name}</span>}
        <span class="tag">{d.origin}</span>
        {d.seat && <span class="tag">{d.seat}</span>}
        <ConfidenceBadge level={d.confidence} />
      </p>
    </header>

    <p class="ent-summary">{d.summary}</p>

    {rank && <p class="ent-ranknote">{rank.note}</p>}

    {chigyo.length > 0 && (
      <section class="ent-chigyo">
        <p class="en-label">知行高</p>
        <table class="ent-table">
          <thead><tr><th>年</th><th>知行高</th><th>典拠</th></tr></thead>
          <tbody>
            {chigyo.map((c) => (
              <tr>
                <td class="num">{c.year}</td>
                <td class="num">{c.koku.toLocaleString()} 石</td>
                <td class="note">{c.sourceRefs.map((r) => r.note).filter(Boolean).join(' ') || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="ent-chigyo-note">
          記録の残る年だけを並べています。年の間が空いているのは、その間の数値が
          手元の資料で確認できていないためです。
        </p>
      </section>
    )}

    <div class="prose ent-body"><Content /></div>

    {people.length > 0 && (
      <section class="ent-related">
        <p class="en-label">この家の人物</p>
        <ul class="ent-people">
          {people.map((p) => (
            <li><a href={`/people/${p.id}/`}>{p.data.name}<span class="rd">{p.data.reading}</span></a></li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="ent-related">
        <p class="en-label">この家に関わる記事</p>
        <div class="ent-related-grid">
          {related.map((a, i) => <ArticleCard article={a} cue={i} />)}
        </div>
      </section>
    )}

    <SourceRefs refs={allRefs} />
  </article>
</Base>

<style>
  .ent { padding-block: clamp(28px, 5vw, 56px) clamp(48px, 7vw, 88px); }
  .ent-head { margin-top: 10px; }
  .ent-head h1 { font-family: var(--f-mincho); font-size: var(--fs-h1); font-weight: 800; line-height: 1.3; }
  .ent-head h1 .rd {
    display: block; font-family: var(--f-sans); font-size: var(--fs-sm);
    font-weight: 400; color: var(--ink-4); margin-top: 6px; letter-spacing: .06em;
  }
  .ent-meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 14px; }
  .ent-meta .tag {
    padding: 3px 10px; border: 1px solid var(--rule); border-radius: 999px;
    font-size: var(--fs-xs); color: var(--ink-3);
  }
  .ent-summary {
    margin-top: 28px; font-size: var(--fs-lg); line-height: 1.95;
    font-family: var(--f-mincho); color: var(--ink);
  }
  .ent-ranknote {
    margin-top: 14px; padding: 12px 16px; background: var(--paper-2); border-radius: 3px;
    font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.95;
  }

  .ent-chigyo { margin-top: 32px; }
  .ent-table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: var(--fs-sm); }
  .ent-table th {
    text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--rule);
    font-size: var(--fs-xs); font-weight: 500; color: var(--ink-3);
  }
  .ent-table td { padding: 10px; border-bottom: 1px solid var(--rule-2); vertical-align: baseline; }
  .ent-table .num { font-family: var(--f-mono); white-space: nowrap; }
  .ent-table .note { font-size: var(--fs-xs); color: var(--ink-4); line-height: 1.8; }
  .ent-chigyo-note { margin-top: 10px; font-size: var(--fs-xs); color: var(--ink-4); line-height: 1.85; }

  .ent-body { margin-top: 28px; }
  .ent-related { margin-top: clamp(36px, 5vw, 56px); }
  .ent-related-grid {
    display: grid; gap: 14px; margin-top: 14px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .ent-people { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .ent-people a {
    display: inline-flex; align-items: baseline; gap: 6px;
    padding: 5px 12px; border: 1px solid var(--rule); border-radius: 999px;
    font-size: var(--fs-sm); color: var(--ink-2); text-decoration: none;
  }
  .ent-people a:hover { border-color: var(--ink-3); color: var(--ink); }
  .ent-people .rd { font-size: 10px; color: var(--ink-4); }
</style>
