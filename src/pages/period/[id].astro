---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ThemeChip from '../../components/ThemeChip.astro';
import { PERIODS, periodById } from '../../data/periods';
import { THEMES } from '../../data/themes';
import { allArticles, articlesInPeriod, timeline } from '../../lib/archive';

export function getStaticPaths() {
  return PERIODS.map((p) => ({ params: { id: p.id } }));
}

const period = periodById(Astro.params.id!);
const i = PERIODS.findIndex((p) => p.id === period.id);
const prev = i > 0 ? PERIODS[i - 1] : null;
const next = i < PERIODS.length - 1 ? PERIODS[i + 1] : null;

const articles = articlesInPeriod(await allArticles(), period.id);
const events = (await timeline()).filter((e) => e.data.period === period.id);

/** この期に記事がある主題（横断の入口） */
const themesHere = THEMES.map((t) => ({
  theme: t,
  count: articles.filter((a) => a.data.theme === t.id).length,
}));

const totalWeight = PERIODS.reduce((n, p) => n + (p.endYear - p.startYear), 0);
---

<Base
  title={`${period.name}（${period.span}）`}
  description={period.lede}
  eraColor={`var(${period.colorVar})`}
>
  <section class="p-hero">
    <div class="inner">
      <nav class="breadcrumb" aria-label="パンくず">
        <a href="/">トップ</a><span class="sep">/</span>
        <a href="/matrix/">時代と主題</a><span class="sep">/</span>
        <span aria-current="page">{period.name}</span>
      </nav>

      <p class="en-label" style={`color:var(${period.colorVar})`}>
        {String(period.order).padStart(2, '0')} · {period.en.toUpperCase()}
      </p>
      <h1>{period.name}</h1>
      <p class="p-span num">{period.span}</p>
      <p class="p-lede">{period.lede}</p>

      <!-- 現在地スパイン：藩の一生のどこにいるか -->
      <div class="p-spine" role="navigation" aria-label="時代の位置">
        {PERIODS.map((p) => (
          <a
            href={`/period/${p.id}/`}
            class:list={['p-spine-seg', p.id === period.id && 'current', `stage-${p.stage}`]}
            style={`--ec:var(${p.colorVar}); --w:${(p.endYear - p.startYear) / totalWeight}`}
            title={`${p.name}（${p.span}）`}
          >
            <span class="sr-only">{p.name}</span>
          </a>
        ))}
      </div>
      <p class="p-spine-legend">
        <span>前史</span><span class="ln"></span><span>藩政 1607–1871</span><span class="ln"></span><span>余波</span>
      </p>
    </div>
  </section>

  <section class="p-body">
    <div class="inner">
      <!-- 主題別の入口 -->
      <div class="p-themes">
        <p class="en-label">この時代を主題から見る</p>
        <div class="p-themes-row">
          {themesHere.map(({ theme, count }) => (
            <a
              class:list={['p-theme', count === 0 && 'is-empty']}
              href={`/matrix/#cell-${period.id}-${theme.id}`}
              style={`--tc: var(${theme.colorVar})`}
            >
              <i></i>
              <span class="n">{theme.name}</span>
              <span class="c">{count > 0 ? `${count}本` : '未執筆'}</span>
            </a>
          ))}
        </div>
      </div>

      {articles.length > 0 ? (
        <>
          <p class="en-label p-count">記事 {articles.length}本 / 目標 {period.target}本</p>
          <div class="p-grid">
            {articles.map((a, n) => <ArticleCard article={a} showPeriod={false} cue={n % 6} />)}
          </div>
        </>
      ) : (
        <div class="p-empty">
          <p class="en-label">IN PREPARATION</p>
          <p class="p-empty-title">この時代の記事はまだありません</p>
          <p class="p-empty-body">
            目標は {period.target}本。先に <a href="/timeline/">年表</a> か
            <a href="/matrix/">俯瞰マトリクス</a> からご覧ください。
          </p>
        </div>
      )}

      {events.length > 0 && (
        <div class="p-events">
          <p class="en-label">この時代の出来事</p>
          <ol class="p-events-list">
            {events.map((e) => (
              <li>
                <span class="y num">{e.data.year}</span>
                <span class="w">{e.data.wareki ?? ''}</span>
                <span class="t">
                  {e.article ? <a href={`/articles/${e.article.id}/`}>{e.data.title}</a> : e.data.title}
                </span>
              </li>
            ))}
          </ol>
          <p class="p-events-more"><a href="/timeline/">年表をすべて見る →</a></p>
        </div>
      )}
    </div>
  </section>

  <nav class="p-nav inner" aria-label="前後の時代">
    {prev ? (
      <a class="p-nav-item prev" href={`/period/${prev.id}/`} style={`--ec:var(${prev.colorVar})`}>
        <span class="dir">前の時代</span><span class="nm">{prev.name}</span>
      </a>
    ) : <span></span>}
    {next && (
      <a class="p-nav-item next" href={`/period/${next.id}/`} style={`--ec:var(${next.colorVar})`}>
        <span class="dir">次の時代</span><span class="nm">{next.name}</span>
      </a>
    )}
  </nav>
</Base>

<style>
  .p-hero { padding-block: clamp(28px, 5vw, 56px) clamp(20px, 3vw, 32px); }
  .p-hero h1 {
    font-family: var(--f-mincho); font-size: var(--fs-h1); font-weight: 800;
    line-height: 1.25; margin-top: 8px;
  }
  .p-span { font-family: var(--f-mono); color: var(--ink-3); font-size: var(--fs-sm); margin-top: 8px; }
  .p-lede { margin-top: 16px; max-width: 44em; color: var(--ink-2); line-height: 2; }

  .p-spine { display: flex; gap: 3px; margin-top: 32px; }
  .p-spine-seg {
    flex: var(--w) 1 0; min-width: 14px; height: 10px; border-radius: 2px;
    background: color-mix(in srgb, var(--ec) 28%, var(--paper-2));
    transition: background .2s, transform .2s;
  }
  .p-spine-seg:hover { background: color-mix(in srgb, var(--ec) 60%, var(--paper-2)); }
  .p-spine-seg.current { background: var(--ec); transform: scaleY(1.7); }
  .p-spine-legend {
    display: flex; align-items: center; gap: 8px; margin-top: 10px;
    font-size: 10px; color: var(--ink-4); font-family: var(--f-mono); letter-spacing: .06em;
  }
  .p-spine-legend .ln { flex: 1; height: 1px; background: var(--rule-2); }

  .p-body { padding-block: clamp(24px, 4vw, 48px) clamp(40px, 6vw, 72px); }

  .p-themes { margin-bottom: 36px; }
  .p-themes-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .p-theme {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; border: 1px solid var(--rule); border-radius: 3px;
    background: var(--card); color: var(--ink-2); text-decoration: none;
    font-size: var(--fs-sm);
    transition: border-color .2s, color .2s;
  }
  .p-theme:hover { border-color: var(--tc); color: var(--ink); }
  .p-theme i { width: 7px; height: 7px; border-radius: 2px; background: var(--tc); }
  .p-theme .c { font-family: var(--f-mono); font-size: 10px; color: var(--ink-4); }
  .p-theme.is-empty { opacity: .5; }

  .p-count { margin-bottom: 16px; }
  .p-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }

  .p-empty {
    padding: 40px 28px; border: 1px dashed var(--rule); border-radius: 4px;
    background: var(--paper-2); text-align: center;
  }
  .p-empty-title { font-family: var(--f-mincho); font-size: var(--fs-lg); margin-top: 8px; }
  .p-empty-body { margin-top: 10px; font-size: var(--fs-sm); color: var(--ink-3); }

  .p-events { margin-top: clamp(40px, 6vw, 64px); }
  .p-events-list { list-style: none; margin-top: 14px; display: grid; gap: 2px; }
  .p-events-list li {
    display: grid; grid-template-columns: 4.5em 6em minmax(0, 1fr); gap: 10px;
    padding: 8px 10px; border-bottom: 1px solid var(--rule-2); align-items: baseline;
    font-size: var(--fs-sm);
  }
  .p-events-list .y { color: var(--ink); font-family: var(--f-mono); }
  .p-events-list .w { color: var(--ink-4); font-size: var(--fs-xs); }
  .p-events-list a { color: inherit; }
  .p-events-more { margin-top: 14px; font-size: var(--fs-sm); }
  @media (max-width: 640px) {
    .p-events-list li { grid-template-columns: 4.5em minmax(0, 1fr); }
    .p-events-list .w { display: none; }
  }

  .p-nav {
    display: flex; justify-content: space-between; gap: 16px;
    padding-block: clamp(28px, 4vw, 48px); border-top: 1px solid var(--rule);
  }
  .p-nav-item {
    display: grid; gap: 4px; text-decoration: none; color: var(--ink-2);
    padding: 12px 16px; border: 1px solid var(--rule); border-radius: 3px;
    transition: border-color .2s;
  }
  .p-nav-item:hover { border-color: var(--ec); }
  .p-nav-item.next { text-align: right; }
  .p-nav-item .dir { font-size: 10px; font-family: var(--f-mono); color: var(--ink-4); letter-spacing: .08em; }
  .p-nav-item .nm { font-family: var(--f-mincho); font-size: var(--fs-sm); }
</style>
