---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { ERAS, PARTS, eraById } from '../../data/eras';

export function getStaticPaths() {
  return ERAS.map((era) => ({ params: { era: era.id } }));
}

const { era: eraId } = Astro.params;
const era = eraById(eraId!);
const part = PARTS.find((p) => p.id === era.part)!;
const eraIndex = ERAS.findIndex((e) => e.id === era.id);
const prevEra = eraIndex > 0 ? ERAS[eraIndex - 1] : null;
const nextEra = eraIndex < ERAS.length - 1 ? ERAS[eraIndex + 1] : null;

const articles = (await getCollection('articles'))
  .filter((a) => a.data.era === era.id)
  .sort((a, b) => a.data.sortYear - b.data.sortYear);
---

<Base title={`${era.name}（${era.period}）`} description={era.lede} eraColor={`var(${era.color})`}>
  <!-- 時代ヘッダー -->
  <section class="era-hero">
    <div class="inner era-hero-inner">
      <div class="era-hero-main">
        <p class="en-label" style={`color:var(${era.color})`}>
          LAYER {String(era.layer).padStart(2, '0')} · {part.num} {part.title} · {era.en.toUpperCase()}
        </p>
        <h1>{era.name}</h1>
        <p class="era-period num">{era.period}</p>
        <p class="era-lede">{era.lede}</p>
      </div>
      <p class="era-hero-v v-text" aria-hidden="true">{era.name}</p>
    </div>
    <!-- 現在地スパイン -->
    <div class="inner">
      <div class="era-locator" role="navigation" aria-label="時代の位置">
        {ERAS.map((e) => (
          <a
            href={`/era/${e.id}/`}
            class:list={{ current: e.id === era.id }}
            style={`--ec:var(${e.color});--w:${e.weight}`}
            title={`${e.name}（${e.period}）`}
          ><span class="sr-only">{e.name}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="era-body">
    <div class="inner">
      {articles.length > 0 ? (
        <>
          <p class="en-label era-count">ARTICLES · {articles.length}</p>
          <div class="era-grid">
            {articles.map((a) => <ArticleCard article={a} />)}
          </div>
        </>
      ) : (
        <div class="era-empty">
          <p class="en-label">IN PREPARATION</p>
          <p class="era-empty-title">この時代の記事は準備中</p>
          <p class="era-empty-body">
            Vault（研究ノート約230ページ）からの移送を順次進めています。先に
            <a href="/timeline/">年表</a> か、記事のある時代からどうぞ。
          </p>
        </div>
      )}
    </div>
  </section>

  <!-- 前後の時代 -->
  <nav class="inner era-pn" aria-label="前後の時代">
    {prevEra ? (
      <a class="era-pn-item" href={`/era/${prevEra.id}/`} style={`--ec:var(${prevEra.color})`}>
        <span class="en-label">← 前の時代</span>
        <span class="era-pn-name">{prevEra.name}</span>
        <span class="era-pn-period num">{prevEra.period}</span>
      </a>
    ) : <span></span>}
    {nextEra ? (
      <a class="era-pn-item next" href={`/era/${nextEra.id}/`} style={`--ec:var(${nextEra.color})`}>
        <span class="en-label">次の時代 →</span>
        <span class="era-pn-name">{nextEra.name}</span>
        <span class="era-pn-period num">{nextEra.period}</span>
      </a>
    ) : <span></span>}
  </nav>
</Base>

<style>
  .era-hero {
    background:
      linear-gradient(to bottom, color-mix(in srgb, var(--era) 14%, transparent), transparent 82%);
    border-bottom: 1px solid var(--rule-2);
    padding: clamp(48px, 7vw, 90px) 0 34px;
  }
  .era-hero-inner {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 40px;
    margin-bottom: clamp(36px, 5vw, 60px);
  }
  .era-hero-main .en-label { display: block; margin-bottom: 18px; }
  .era-hero h1 {
    font-family: var(--f-mincho);
    font-size: clamp(38px, 6vw, 72px);
    font-weight: 800; line-height: 1.2; letter-spacing: .03em;
    font-feature-settings: "palt";
    margin-bottom: 10px;
  }
  .era-period { font-family: var(--f-mono); font-size: 14px; letter-spacing: .12em; color: var(--era); margin-bottom: 22px; }
  .era-lede { max-width: 34em; font-size: 15px; line-height: 2.1; color: var(--ink-2); text-wrap: pretty; }
  .era-hero-v {
    font-size: clamp(20px, 2.6vw, 30px); font-weight: 600;
    color: color-mix(in srgb, var(--era) 55%, transparent);
    border-right: 1px solid color-mix(in srgb, var(--era) 35%, transparent);
    padding-right: 16px;
    height: 240px; flex: none;
  }
  @media (max-width: 720px) { .era-hero-v { display: none; } }

  .era-locator { display: flex; gap: 2px; height: 10px; border-radius: 5px; overflow: hidden; }
  .era-locator a { flex: var(--w) 1 0; background: color-mix(in srgb, var(--ec) 34%, transparent); transition: background .2s; }
  .era-locator a:hover { background: color-mix(in srgb, var(--ec) 70%, transparent); }
  .era-locator a.current { background: var(--ec); box-shadow: 0 0 0 2px var(--paper), 0 0 0 3.5px var(--ec); border-radius: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

  .era-body { padding: clamp(48px, 6vw, 72px) 0 0; }
  .era-count { display: block; margin-bottom: 20px; }
  .era-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }

  .era-empty {
    padding: clamp(48px, 7vw, 80px) 32px;
    border: 1px dashed var(--rule);
    background: var(--paper-2);
    text-align: center;
  }
  .era-empty-title { font-family: var(--f-mincho); font-size: 22px; font-weight: 700; margin: 12px 0 10px; }
  .era-empty-body { font-size: 13.5px; color: var(--ink-3); }
  .era-empty-body a { color: var(--ink-2); }

  .era-pn { display: grid; grid-template-columns: 1fr 1fr; gap: 2px; margin-top: clamp(56px, 7vw, 88px); }
  .era-pn-item {
    display: flex; flex-direction: column; gap: 5px;
    padding: 22px 24px;
    background: var(--card); border: 1px solid var(--rule-2); border-top: 3px solid var(--ec);
    text-decoration: none;
    transition: transform .4s var(--ease-out), box-shadow .4s var(--ease-out);
  }
  .era-pn-item:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .era-pn-item.next { text-align: right; align-items: flex-end; }
  .era-pn-name { font-family: var(--f-mincho); font-size: 17px; font-weight: 700; color: var(--ink); }
  .era-pn-period { font-size: 11px; color: var(--ink-4); }
  @media (max-width: 560px) { .era-pn { grid-template-columns: 1fr; } }
</style>
