---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PeriodChip from '../../components/PeriodChip.astro';
import ThemeChip from '../../components/ThemeChip.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SourceRefs from '../../components/SourceRefs.astro';
import { periodById } from '../../data/periods';
import { themeById } from '../../data/themes';
import { CONFIDENCE } from '../../data/confidence';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const data = article.data;
/** 代表の時代（複数期にまたがる制度記事は最初の期を代表とする） */
const period = periodById(data.periods[0]);
const theme = themeById(data.theme);
const conf = CONFIDENCE[data.confidence];
const KIND = { A: '主題記事', B: '記事', C: '小記事' } as const;

// 読了時間（日本語 約550字/分）
const charCount = article.body?.replace(/\s/g, '').length ?? 0;
const readMin = Math.max(1, Math.ceil(charCount / 550));

// 目次は h2 のみ（h3 は本文内の道標に留める）。脚注の自動見出しは除外
const toc = headings.filter((h) => h.depth === 2 && h.slug !== 'footnote-label');

// 前後記事（代表年順）
const all = (await getCollection('articles')).sort((a, b) => a.data.sortYear - b.data.sortYear);
const idx = all.findIndex((a) => a.id === article.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

// 関連記事：frontmatter 指定 → 不足分は同時代で補完
const relatedIds = new Set(data.related.map((r) => r.id));
const relatedSpecified = all.filter((a) => relatedIds.has(a.id));
// 不足分は「同じ主題」→「同じ時代」の順で補う
const relatedFallback = all.filter(
  (a) =>
    a.id !== article.id &&
    !relatedIds.has(a.id) &&
    (a.data.theme === data.theme || a.data.periods.some((x) => data.periods.includes(x)))
);
const related = [...relatedSpecified, ...relatedFallback].slice(0, 3);
---

<Base
  title={data.title}
  description={data.summary}
  eraColor={`var(${period.colorVar})`}
  published={data.created}
  modified={data.updated}
>
  <div class="progress-bar" aria-hidden="true"><i id="progressFill"></i></div>

  <div class="inner">
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">トップ</a><span class="sep">/</span>
      <a href={`/period/${period.id}/`}>{period.name}</a><span class="sep">/</span>
      <a href={`/theme/${theme.id}/`}>{theme.name}</a><span class="sep">/</span>
      <span aria-current="page">{data.title}</span>
    </nav>
  </div>

  <div
    class="article-grid inner"
    data-pagefind-body
    data-pagefind-filter={`種別:記事`}
    data-pagefind-meta={`period:${period.name}, theme:${theme.name}`}
  >
    <!-- 左：目次サイドバー -->
    <aside class="article-toc" aria-label="目次">
      <div class="toc-sticky">
        <p class="en-label">CONTENTS / 目次</p>
        <ol id="tocList">
          {toc.map((h, i) => (
            <li>
              <a href={`#${h.slug}`} data-toc={h.slug}>
                <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
                {h.text}
              </a>
            </li>
          ))}
          <li><a href="#sources" data-toc="sources"><span class="toc-num">§</span>出典・参考文献</a></li>
        </ol>
        <div class="toc-era">
          <p class="en-label">時代と主題</p>
          {data.periods.map((id) => <PeriodChip id={id} />)}
          <ThemeChip id={data.theme} />
          <p class="toc-layer">{KIND[data.kind]}</p>
        </div>
      </div>
    </aside>

    <!-- 中央：本文 -->
    <div class="article-main" id="articleMain">
      <header class="article-header">
        <p class="article-layer en-label" style={`color:var(${period.colorVar})`}>
          {period.name} · {theme.name} {data.year && `· ${data.year}`}
        </p>
        <h1 class="article-title">{data.title}</h1>
        {data.subtitleEn && <p class="article-subtitle">{data.subtitleEn}</p>}
        <div class="article-tags">
          {data.periods.map((id) => <PeriodChip id={id} span={false} />)}
          <ThemeChip id={data.theme} />
          {data.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
        <div class="article-meta">
          <span class={`badge ${conf.cls}`} title={conf.desc}>{conf.label}</span>
          <span>初版 <time class="num">{data.created}</time></span>
          <span>最終更新 <time class="num">{data.updated}</time></span>
          <span>約<span class="num">{charCount.toLocaleString()}</span>字 · <span class="num">{readMin}</span>分</span>
          <span>出典 <span class="num">{data.sourceRefs.length}</span>件</span>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <!-- 諸説のあるもの -->
      {data.disputes.length > 0 && (
        <section class="disputes" aria-label="諸説">
          <p class="en-label">諸説のあるもの</p>
          {data.disputes.map((d) => (
            <div class="dispute">
              <p class="dispute-label">{d.label}</p>
              <ul>
                {d.positions.map((pos) => (
                  <li><span class="by">{pos.by}</span>{pos.claim}</li>
                ))}
              </ul>
            </div>
          ))}
          <p class="disputes-note">本アーカイブはどちらか一方を採らず、両論を併記します。</p>
        </section>
      )}

      <!-- 出典 -->
      <div id="sources">
        <SourceRefs refs={data.sourceRefs} title="出典・参考文献" />
        <p class="sources-note">{conf.desc}。誤りの指摘は歓迎します（→ <a href="/about/">このサイトについて</a>）。</p>
      </div>

      <!-- 前後の記事（時系列） -->
      <nav class="pn" aria-label="時系列の前後の記事">
        {prev ? (
          <a class="pn-item pn-prev" href={`/articles/${prev.id}/`} style={`--ec:var(${periodById(prev.data.periods[0]).colorVar})`}>
            <span class="en-label">← 時系列で前</span>
            <span class="pn-title">{prev.data.title}</span>
            <span class="pn-year num">{prev.data.year}</span>
          </a>
        ) : <span class="pn-item pn-empty"></span>}
        {next ? (
          <a class="pn-item pn-next" href={`/articles/${next.id}/`} style={`--ec:var(${periodById(next.data.periods[0]).colorVar})`}>
            <span class="en-label">時系列で次 →</span>
            <span class="pn-title">{next.data.title}</span>
            <span class="pn-year num">{next.data.year}</span>
          </a>
        ) : <span class="pn-item pn-empty"></span>}
      </nav>

      <!-- 関連記事 -->
      {related.length > 0 && (
        <section class="related-sec" aria-label="関連記事">
          <p class="en-label">RELATED / 関連記事</p>
          <div class="related-grid">
            {related.map((a) => <ArticleCard article={a} />)}
          </div>
        </section>
      )}
    </div>

    <!-- 右：欄外注コラム（1440px以上でJSが脚注を移設） -->
    <div class="article-margin" aria-hidden="true"></div>
  </div>
</Base>

<style>
  .disputes {
    margin-top: clamp(32px, 5vw, 56px); padding: 20px 22px;
    border: 1px solid var(--rule); border-radius: 3px; background: var(--paper-2);
  }
  .dispute { margin-top: 12px; }
  .dispute-label { font-family: var(--f-mincho); font-size: var(--fs-sm); color: var(--ink); }
  .dispute ul { list-style: none; margin-top: 8px; display: grid; gap: 6px; }
  .dispute li { font-size: var(--fs-sm); color: var(--ink-2); line-height: 1.9; }
  .dispute .by {
    display: inline-block; margin-right: 10px; padding: 1px 8px;
    border: 1px solid var(--rule); border-radius: 999px;
    font-size: 10px; color: var(--ink-4);
  }
  .disputes-note { margin-top: 14px; font-size: var(--fs-xs); color: var(--ink-4); }

  /* 幅はトークン層が決める。--w-wide が 1440px に広がった分は
     本文の行長ではなく、図版が本文からはみ出す余地（--bleed）に回す。
     ページ単位の設計（課題3）が戻ってきたら、ここを作り直す。 */
  .article-grid {
    display: grid;
    grid-template-columns: var(--col-toc) minmax(0, 1fr) var(--col-margin);
    gap: var(--sp-7, 48px);
    justify-content: center;
    padding-top: 28px;
  }
  @media (max-width: 1439px) {
    .article-grid { grid-template-columns: var(--col-toc) minmax(0, 1fr); }
    .article-margin { display: none; }
  }
  @media (max-width: 1023px) {
    .article-grid { grid-template-columns: minmax(0, 1fr); }
    .article-toc { display: none; }
  }

  /* --- 目次 --- */
  .toc-sticky { position: sticky; top: 92px; }
  .toc-sticky > .en-label { display: block; margin-bottom: 14px; }
  .toc-sticky ol { list-style: none; }
  .toc-sticky a {
    display: flex; gap: 9px; align-items: baseline;
    padding: 7px 0 7px 14px;
    border-left: 2px solid var(--rule);
    font-size: 12.5px; line-height: 1.55; color: var(--ink-3);
    text-decoration: none;
    transition: color .2s, border-color .2s, background .2s;
  }
  .toc-sticky a:hover { color: var(--ink); }
  .toc-sticky a.active {
    border-left-color: var(--era);
    color: var(--ink);
    background: linear-gradient(90deg, var(--era-soft), transparent);
  }
  .toc-num { font-family: var(--f-mono); font-size: 9.5px; color: var(--era); flex: none; }
  .toc-era { margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--rule); display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .toc-layer { font-family: var(--f-mono); font-size: 9.5px; letter-spacing: .2em; color: var(--ink-4); }

  /* --- 記事ヘッダー --- */
  .article-main { position: relative; min-width: 0; }
  .article-header {
    padding-bottom: 30px; margin-bottom: 36px;
    border-bottom: 1px solid var(--rule);
  }
  .article-layer { display: block; margin-bottom: 16px; }
  .article-title {
    font-family: var(--f-mincho);
    font-size: var(--fs-h1);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: .03em;
    font-feature-settings: "palt";
    margin-bottom: 10px;
    text-wrap: pretty;
  }
  .article-subtitle {
    font-family: var(--f-en); font-style: italic;
    font-size: 17px; color: var(--ink-3); letter-spacing: .05em;
    margin-bottom: 20px;
  }
  .article-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
  .tag {
    display: inline-flex; align-items: center;
    padding: 3px 12px 4px;
    border: 1px solid var(--rule); border-radius: 999px;
    background: var(--card);
    font-size: var(--fs-xs); color: var(--ink-2); letter-spacing: .06em;
  }
  .article-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px;
    font-size: 12px; color: var(--ink-3); letter-spacing: .03em;
  }

  /* --- 出典 --- */
  .sources {
    margin-top: 64px;
    padding: 24px 28px;
    background: var(--card);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--era);
    box-shadow: var(--shadow);
  }
  .sources > .en-label { display: block; margin-bottom: 14px; }
  .sources ol { list-style: none; }
  .sources li {
    font-size: 13.5px; line-height: 1.9; color: var(--ink-2);
    padding: 6px 0;
    border-bottom: 1px dashed var(--rule-2);
    scroll-margin-top: 100px;
  }
  .sources li:target { background: var(--era-soft); }
  .src-num { font-family: var(--f-mono); font-size: 10.5px; color: var(--era); margin-right: 10px; }
  .sources-note { margin-top: 14px; font-size: 11.5px; color: var(--ink-4); }
  .sources-note a { color: var(--ink-3); }

  /* --- 前後ナビ --- */
  .pn {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2px;
    margin-top: 40px;
  }
  .pn-item {
    display: flex; flex-direction: column; gap: 6px;
    padding: 20px 22px;
    background: var(--card);
    border: 1px solid var(--rule-2);
    border-top: 3px solid var(--ec, var(--rule));
    text-decoration: none;
    transition: transform .4s var(--ease-out), box-shadow .4s var(--ease-out);
  }
  a.pn-item:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
  .pn-next { text-align: right; align-items: flex-end; }
  .pn-empty { background: transparent; border-color: transparent; }
  .pn-title { font-family: var(--f-mincho); font-size: 15px; font-weight: 700; line-height: 1.5; color: var(--ink); }
  .pn-year { font-size: 11px; color: var(--ink-4); }
  @media (max-width: 640px) { .pn { grid-template-columns: 1fr; } }

  /* --- 関連 --- */
  .related-sec { margin-top: 56px; }
  .related-sec > .en-label { display: block; margin-bottom: 18px; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
</style>

<script>
  function initArticle() {
    const main = document.getElementById('articleMain');
    if (!main) return;

    // --- 読了プログレスバー ---
    const fill = document.getElementById('progressFill');
    const onScroll = () => {
      if (!fill) return;
      const rect = main.getBoundingClientRect();
      const total = rect.height - innerHeight;
      const p = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1;
      fill.style.setProperty('--progress', String(p));
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // --- 目次スクロールスパイ ---
    const tocLinks = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('[data-toc]').forEach((a) => {
      tocLinks.set(a.dataset.toc!, a);
    });
    const sections = document.querySelectorAll<HTMLElement>('.prose h2[id], #sources');
    if (sections.length && tocLinks.size) {
      const spy = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              tocLinks.forEach((a) => a.classList.remove('active'));
              tocLinks.get(e.target.id)?.classList.add('active');
            }
          }
        },
        { rootMargin: '-15% 0px -70% 0px' }
      );
      sections.forEach((s) => spy.observe(s));
    }

    // --- 欄外注：脚注を右マージンへ移設（1440px以上） ---
    const moveNotes = () => {
      const foot = main.querySelector<HTMLElement>('.prose .footnotes');
      if (!foot) return;
      const wide = matchMedia('(min-width: 1440px)').matches;
      main.querySelectorAll('.sidenote').forEach((n) => n.remove());
      if (!wide) { foot.style.display = ''; return; }

      const items = foot.querySelectorAll<HTMLElement>('li[id]');
      let lastBottom = 0;
      let moved = 0;
      items.forEach((li) => {
        const id = li.id; // user-content-fn-1 等
        const ref = main.querySelector<HTMLElement>(`[href="#${CSS.escape(id)}"]`);
        if (!ref) return;
        const note = document.createElement('aside');
        note.className = 'sidenote';
        const num = ref.textContent?.replace(/\D/g, '') || '';
        const body = li.cloneNode(true) as HTMLElement;
        body.querySelectorAll('[data-footnote-backref]').forEach((b) => b.remove());
        note.innerHTML = `<span class="sn-num">${num}</span>` + body.innerHTML;
        note.style.left = 'calc(100% + 56px)';
        const top = ref.getBoundingClientRect().top - main.getBoundingClientRect().top;
        const y = Math.max(top, lastBottom + 12);
        note.style.top = `${y}px`;
        main.appendChild(note);
        lastBottom = y + note.offsetHeight;
        moved++;
      });
      foot.style.display = moved > 0 ? 'none' : '';
    };
    moveNotes();
    addEventListener('resize', moveNotes, { passive: true });
    // フォント読み込み後に位置を再計算
    (document as any).fonts?.ready?.then(moveNotes);
  }
  initArticle();
  document.addEventListener('astro:page-load', initArticle);
</script>
