    { title: '三重津海軍所<br/>— 日本初の蒸気船修理場', era: '幕末', year: '1858', eraColor: 'var(--c-bakumatsu)', bg: 'linear-gradient(160deg,#0e2038,#04080e)', ph: '三重津', desc: '日本最古の洋式ドックが佐賀にあった。世界遺産「明治日本の産業革命遺産」の原点。有明海に沈む遺構が語る幕末の技術革命。', theme: 'テクノロジー · 海 · 世界遺産' },
    { title: '佐賀平野はどうやって<br/>できたのか', era: '地質', year: 'BC 10,000〜', eraColor: 'var(--c-geo)', bg: 'linear-gradient(160deg,#4a4e58,#1e2028)', ph: '有明海と佐賀平野', desc: '有明海の干拓と堆積が生んだ佐賀平野。この大地の形成が、のちの農業・経済・政治の土台となった。地質から歴史を読む。', theme: '海 · まちづくり · 地理' },
    { title: '東名遺跡<br/>— 世界最古級の編み籠', era: '縄文', year: 'BC 6000', eraColor: 'var(--c-yayoi)', bg: 'linear-gradient(160deg,#3a4a20,#141a0c)', ph: '東名遺跡', desc: '佐賀市東名に眠る縄文時代の低湿地遺跡。世界最古級の編み籠が出土し、日本の先史文化の水準を塗り替えた発見の全貌。', theme: 'ものづくり · 世界最古 · くらし' },
    { title: '少弐氏と大宰府<br/>— 九州の守護', era: '中世', year: '1196', eraColor: 'var(--c-medieval)', bg: 'linear-gradient(160deg,#3a2818,#160e08)', ph: '少弐氏', desc: '鎌倉時代、少弐資頼が肥前に下向し大宰少弐として九州を統治した。中央と地方、武士団の形成を佐賀から読む。', theme: '権力 · 国防 · 制度' },
    { title: '沖田畷の戦い<br/>— 隆信の死と鍋島の台頭', era: '龍造寺氏', year: '1584', eraColor: 'var(--c-ryuzoji)', bg: 'linear-gradient(160deg,#6a2010,#280c04)', ph: '沖田畷', desc: '九州制覇を目前に龍造寺隆信が島津軍に敗死。この一戦が龍造寺から鍋島への権力移行を決定的にした転換点。', theme: '権力闘争 · 逆転劇 · サバイバル' },
    { title: '鍋島氏への権力移行<br/>— 龍造寺から佐賀藩へ', era: '龍造寺氏', year: '1600頃', eraColor: 'var(--c-ryuzoji)', bg: 'linear-gradient(160deg,#2a1a3a,#0e0814)', ph: '鍋島直茂', desc: '龍造寺の後見から実質支配へ。鍋島直茂はいかにして「禅譲」を成し遂げたのか。権力移行の内幕と正統性の構築。', theme: '権力闘争 · 制度 · 思想' },
    { title: '長崎警備と<br/>佐賀藩の国防', era: '佐賀藩（江戸）', year: '1641〜', eraColor: 'var(--c-edo)', bg: 'linear-gradient(160deg,#1a2a40,#080e1a)', ph: '長崎警備', desc: '江戸幕府から命じられた長崎警備は、佐賀藩に莫大な費用と技術革新の機会をもたらした。鎖国体制と外圧の最前線。', theme: '国防 · 貿易 · 海' },
    { title: '佐賀の乱<br/>— 江藤新平の敗北', era: '近代', year: '1874', eraColor: 'var(--c-modern)', bg: 'linear-gradient(160deg,#5a4a10,#1e1804)', ph: '佐賀の乱', desc: '明治7年、司法卿・江藤新平が佐賀で挙兵し敗れた。西南の役に先立つ士族反乱の実像と、近代国家形成の暴力。', theme: '権力闘争 · サバイバル · 近代' },
    { title: '佐賀の七賢人<br/>— 明治維新を動かした人々', era: '幕末維新', year: '1860年代', eraColor: 'var(--c-bakumatsu)', bg: 'linear-gradient(160deg,#b83a1f,#3a0a06)', ph: '七賢人', desc: '大隈重信・江藤新平・副島種臣ら「佐賀の七賢人」が明治政府の中枢を担った。なぜ人口わずかな佐賀から多くの指導者が輩出されたのか。', theme: '権力 · 教育 · 近代' },
    { title: '有田焼の海外輸出<br/>— VOCと磁器貿易', era: '佐賀藩（江戸）', year: '1650〜', eraColor: 'var(--c-edo)', bg: 'linear-gradient(160deg,#6a5010,#281e04)', ph: '海外輸出', desc: 'オランダ東インド会社（VOC）を通じ、有田焼はヨーロッパの宮廷を席巻した。世界市場に進出した江戸日本の磁器産業。', theme: '貿易 · ものづくり · 国際' },
  ];

  let slotAssign = [0,1,2,3,4,5], active = 0, timer = null;
  const thumbs = document.querySelectorAll('.story-thumb');
  const featItems = document.querySelectorAll('.story-feat-item');

  function renderSlot(si, pi) {
    const a = POOL[pi], fi = featItems[si], th = thumbs[si];
    fi.querySelector('.story-feat-bg').style.background = a.bg;
    fi.querySelector('.ph-img-label').innerHTML = `<strong>[ ${a.ph} ]</strong>写真を配置`;
    fi.querySelector('.story-feat-cat-dot').style.background = a.eraColor;
    fi.querySelector('.story-feat-cat-label').textContent = `${a.era} · ${a.year}`;
    fi.querySelector('.story-feat-title').innerHTML = a.title;
    fi.querySelector('.story-feat-desc').textContent = a.desc;
    fi.querySelector('.story-feat-meta').textContent = `テーマ：${a.theme}`;
    th.style.setProperty('--era-c', a.eraColor);
    th.querySelector('.story-thumb-bg .ph-img').style.background = a.bg;
    th.querySelector('.ph-img-label').textContent = a.ph;
    th.querySelector('.story-thumb-era-dot').style.background = a.eraColor;
    th.querySelector('.story-thumb-era-label').textContent = `${a.era} · ${a.year}`;
    th.querySelector('.story-thumb-title').innerHTML = a.title.replace('<br/>', ' ');
    slotAssign[si] = pi;
  }

  function randomFreshIdx() {
    const used = new Set(slotAssign);
    const avail = POOL.map((_,i)=>i).filter(i=>!used.has(i));
    return avail.length ? avail[Math.floor(Math.random()*avail.length)] : Math.floor(Math.random()*POOL.length);
  }

  let hoverActive = null;
  function applyActive(idx) {
    featItems.forEach(el => el.classList.toggle('active', +el.dataset.idx === idx));
    thumbs.forEach(el => el.classList.toggle('active', +el.dataset.idx === idx));
  }
  function activate(idx) {
    if (idx === active) return;
    const prev = active; active = idx;
    if (hoverActive === null) applyActive(idx);
    setTimeout(() => renderSlot(prev, randomFreshIdx()), 500);
  }
  function startTimer() { clearInterval(timer); timer = setInterval(() => activate((active+1)%thumbs.length), 7000); }

  thumbs.forEach(th => {
    th.addEventListener('click', () => activate(+th.dataset.idx));
    th.addEventListener('pointerenter', () => { hoverActive = +th.dataset.idx; applyActive(hoverActive); });
    th.addEventListener('pointerleave', () => { hoverActive = null; applyActive(active); });
  });
  startTimer();
})();

/* Smooth anchor scroll */
document.querySelectorAll('a[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    const t = document.querySelector(a.getAttribute('href'));
    if (t) { e.preventDefault(); t.scrollIntoView({ behavior:'smooth', block:'start' }); }
  });
});
</script>

</Layout>
