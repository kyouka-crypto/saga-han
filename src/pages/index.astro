---
import Layout from '../layouts/Layout.astro';
---
<Layout title="佐賀通史アーカイブ — ある土地の伝記">

<style is:global>
/* ============================================================
   HERO
   ============================================================ */
.hero {
  position:relative; width:100%; height:100svh;
  min-height:640px; overflow:hidden; background:#0c0a08;
}
.hero-mosaic {
  position:absolute; inset:0;
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  grid-template-rows:1fr 1fr;
  gap:2px;
}
.hero-mosaic .cell { position:relative; overflow:hidden; }
.hero-mosaic .cell:first-child { grid-column:1/3; grid-row:1/3; }

.hero-ph {
  position:absolute; inset:0;
  display:flex; flex-direction:column;
  align-items:center; justify-content:center;
}
.hero-ph::before {
  content:''; position:absolute; inset:0;
  background:repeating-linear-gradient(0deg,transparent 0 38px,rgba(255,255,255,.02) 38px 40px),
             repeating-linear-gradient(90deg,transparent 0 38px,rgba(255,255,255,.02) 38px 40px);
}
.cell:nth-child(1) .hero-ph { background:linear-gradient(160deg,#1a1408 0%,#0c0c1a 100%); }
.cell:nth-child(2) .hero-ph { background:linear-gradient(160deg,#2a1508 0%,#180806 100%); }
.cell:nth-child(3) .hero-ph { background:linear-gradient(160deg,#0a1828 0%,#060a14 100%); }
.cell:nth-child(4) .hero-ph { background:linear-gradient(160deg,#1a0c1a 0%,#0a0610 100%); }

.hero-ph-label {
  position:relative; font-family:var(--f-mincho); font-size:11px;
  color:rgba(255,255,255,.3); letter-spacing:.15em; text-align:center; line-height:2;
}
.hero-ph-label strong { display:block; font-size:13px; color:rgba(255,255,255,.5); }

.hero-overlay {
  position:absolute; inset:0; pointer-events:none;
  background:
    linear-gradient(to right, rgba(12,10,8,.85) 0%, rgba(12,10,8,.3) 55%, rgba(12,10,8,.08) 100%),
    linear-gradient(to top, rgba(0,0,0,.45) 0%, transparent 38%);
}

.hero-content {
  position:absolute; top:50%; left:8%;
  transform:translateY(-50%); max-width:600px;
}
.hero-eyebrow {
  font-family:var(--f-en); font-style:italic; font-size:15px;
  color:rgba(255,255,255,.55); letter-spacing:.14em;
  display:flex; align-items:center; gap:12px; margin-bottom:16px;
}
.hero-eyebrow::before {
  content:''; display:block; width:30px; height:1px; background:rgba(255,255,255,.4);
}
.hero-title {
  font-family:var(--f-mincho); font-size:clamp(36px,5vw,68px);
  font-weight:800; color:#fff; line-height:1.2;
  letter-spacing:.03em; text-shadow:0 2px 40px rgba(0,0,0,.55); margin-bottom:18px;
}
.hero-title em {
  font-style:normal; color:rgba(255,255,255,.5);
  font-size:.55em; font-weight:400; display:block;
  margin-bottom:4px; letter-spacing:.08em;
  font-family:var(--f-en); font-style:italic;
}
.hero-sub {
  font-size:15px; color:rgba(255,255,255,.7);
  line-height:1.9; max-width:440px; text-wrap:pretty;
}
.hero-cta {
  display:inline-flex; align-items:center; gap:10px;
  margin-top:28px; padding:12px 28px;
  background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.32);
  color:#fff; font-size:13px; font-weight:500; letter-spacing:.08em;
  text-decoration:none; transition:background .25s, border-color .25s;
}
.hero-cta:hover { background:rgba(255,255,255,.2); border-color:rgba(255,255,255,.65); }
.hero-cta svg { transition:transform .25s; }
.hero-cta:hover svg { transform:translateX(4px); }

.hero-scroll {
  position:absolute; bottom:30px; left:50%; transform:translateX(-50%);
  display:flex; flex-direction:column; align-items:center; gap:8px;
  color:rgba(255,255,255,.4); font-family:var(--f-en); font-size:10px; letter-spacing:.2em;
}
.scroll-line {
  width:1px; height:40px;
  background:linear-gradient(to bottom,rgba(255,255,255,.5),transparent);
  animation:scrollpulse 2s ease-in-out infinite;
}
@keyframes scrollpulse {
  0%,100%{ opacity:.4; transform:scaleY(1); }
  50%{ opacity:1; transform:scaleY(.7); }
}

/* ============================================================
   CON_ABOUT
   ============================================================ */
.con_about { padding:100px 0; background:var(--white); overflow:hidden; }
.con_about-inner {
  max-width:1160px; margin:0 auto; padding:0 40px;
  display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;
}
.con_about-visual { position:relative; }
.con_about-img-main { width:100%; aspect-ratio:4/3; position:relative; overflow:hidden; }
.con_about-img-main .ph-img {
  position:absolute; inset:0; display:flex; flex-direction:column;
  align-items:center; justify-content:center;
  background:linear-gradient(135deg,#e8d8a8 0%,#c4a870 40%,#8a6030 100%);
}
.con_about-img-main .ph-img::before {
  content:''; position:absolute; inset:0;
  background:repeating-linear-gradient(45deg,transparent 0 20px,rgba(0,0,0,.04) 20px 21px);
}
.ph-img-label {
  position:relative; font-family:var(--f-mincho); font-size:13px;
  color:rgba(255,255,255,.8); letter-spacing:.14em;
  text-align:center; text-shadow:0 1px 4px rgba(0,0,0,.4);
}
.con_about-img-sub {
  position:absolute; bottom:-24px; right:-24px;
  width:44%; aspect-ratio:1; overflow:hidden;
  background:var(--paper); border:4px solid var(--white);
}
.con_about-img-sub .ph-img { background:linear-gradient(135deg,#1a2a4a 0%,#0f1e38 100%); }

.con_about-text { padding-bottom:24px; }
.con_about-label {
  font-family:var(--f-en); font-style:italic; font-size:13px;
  letter-spacing:.2em; color:var(--navy); margin-bottom:14px;
  display:flex; align-items:center; gap:12px;
}
.con_about-label::before { content:''; display:block; width:28px; height:1px; background:var(--navy); }
.con_about-title {
  font-family:var(--f-mincho); font-size:clamp(26px,2.8vw,38px);
  font-weight:700; line-height:1.3; letter-spacing:.04em; margin-bottom:26px;
}
.con_about-title small {
  display:block; font-size:.44em; font-weight:500;
  color:var(--ink-2); letter-spacing:.08em; margin-bottom:5px;
}
.con_about-body { font-size:15px; line-height:2; color:var(--ink-2); margin-bottom:26px; text-wrap:pretty; }
.con_about-body p+p { margin-top:1em; }
.con_about-stats {
  display:grid; grid-template-columns:repeat(3,1fr);
  border:1px solid var(--rule); margin-bottom:30px;
}
.stat { padding:15px 12px; border-right:1px solid var(--rule); text-align:center; }
.stat:last-child { border-right:none; }
.stat-num { font-family:var(--f-mincho); font-size:22px; font-weight:700; color:var(--navy); line-height:1; }
.stat-num sup { font-size:.48em; vertical-align:top; margin-top:3px; }
.stat-label { font-size:11px; color:var(--ink-3); margin-top:5px; letter-spacing:.04em; }
.btn-more {
  display:inline-flex; align-items:center; gap:10px;
  padding:12px 28px; background:var(--navy); color:#fff;
  font-size:13px; font-weight:500; letter-spacing:.06em;
  text-decoration:none; transition:background .2s;
}
.btn-more:hover { background:#2a4070; }

/* ============================================================
   CON_TIMELINE
   ============================================================ */
.con_timeline { padding:100px 0 120px; background:var(--paper); overflow:hidden; }
.timeline-wrap { max-width:1160px; margin:0 auto; padding:0 40px; }
.timeline-hint {
  margin-top:16px; font-size:13px; color:var(--ink-3);
  display:flex; align-items:center; justify-content:center; gap:24px;
}
.timeline-hint .arrow { font-family:var(--f-en); font-size:18px; }

.timeline-scroll-area {
  overflow-x:auto; overflow-y:visible;
  padding:64px 0 80px; cursor:grab; user-select:none;
}
.timeline-scroll-area:active { cursor:grabbing; }
.timeline-scroll-area::-webkit-scrollbar { height:4px; }
.timeline-scroll-area::-webkit-scrollbar-thumb { background:var(--ink-3); border-radius:2px; }
.timeline-scroll-area::-webkit-scrollbar-track { background:var(--paper-2); }

.timeline-stage { position:relative; width:1600px; height:300px; }

.timeline-rail {
  position:absolute; top:50%; left:0; right:0; height:10px;
  transform:translateY(-50%); display:flex;
  border-radius:5px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.14);
}
.rail-seg { height:100%; flex:var(--w,1); background:var(--c,#888); }

.tl-edge {
  position:absolute; top:50%; transform:translateY(-50%);
  font-family:var(--f-en); font-style:italic; font-size:10px;
  letter-spacing:.16em; color:rgba(255,255,255,.75);
  background:var(--ink); padding:2px 9px; white-space:nowrap; z-index:20;
  pointer-events:none;
}
.tl-edge.right { right:0; }
.tl-edge.left  { left:0; }

.yr-tick {
  position:absolute; bottom:4px; transform:translateX(-50%);
  display:flex; flex-direction:column; align-items:center; gap:4px;
}
.yr-tick-line { width:1px; height:11px; background:var(--ink-3); }
.yr-tick-label { font-family:'JetBrains Mono',monospace; font-size:10px; color:var(--ink-3); white-space:nowrap; }

.evt { position:absolute; top:50%; transform:translateX(-50%); cursor:pointer; }
.evt-dot {
  position:absolute; left:50%; transform:translate(-50%,-50%);
  width:14px; height:14px; border-radius:50%;
  background:var(--paper); border:2.5px solid var(--c,#888);
  box-shadow:0 0 0 3px rgba(0,0,0,.1); z-index:5; transition:transform .2s, background .2s;
}
.evt:hover .evt-dot { transform:translate(-50%,-50%) scale(1.5); background:var(--c,#888); }
.evt-line { position:absolute; left:50%; width:1px; background:var(--c,#888); opacity:.5; z-index:2; }
.evt.up .evt-line { bottom:50%; transform:translateX(-50%); }
.evt.dn .evt-line { top:50%;   transform:translateX(-50%); }
.evt-card {
  position:absolute; left:50%; transform:translateX(-50%);
  min-width:84px; max-width:130px; background:var(--white);
  border:1px solid var(--c,#888); padding:5px 8px;
  text-align:center; box-shadow:2px 2px 0 rgba(0,0,0,.05);
  transition:box-shadow .2s; z-index:4;
}
.evt:hover .evt-card { box-shadow:3px 3px 0 rgba(0,0,0,.1); }
.evt.up .evt-card { bottom:calc(50% + var(--lh,48px) + 2px); }
.evt.dn .evt-card { top:calc(50%  + var(--lh,48px) + 2px); }
.evt-year  { font-family:'JetBrains Mono',monospace; font-size:9px; color:var(--c,#888); letter-spacing:.06em; margin-bottom:2px; }
.evt-title { font-family:var(--f-mincho); font-size:11px; font-weight:600; color:var(--ink); line-height:1.35; }
.evt-era   { font-family:var(--f-sans); font-size:9px; color:var(--ink-3); margin-top:3px; }

.evt.dim .evt-dot { width:8px; height:8px; opacity:.45; }
.evt.dim .evt-card { opacity:.45; }
.evt.dim .evt-line { opacity:.22; }
.evt.dim:hover .evt-dot { opacity:1; }
.evt.dim:hover .evt-card { opacity:1; }

.timeline-legend {
  display:flex; flex-wrap:wrap; gap:6px 18px;
  margin-top:24px; padding-top:18px; border-top:1px solid var(--rule);
}
.tl-leg-item { display:flex; align-items:center; gap:6px; font-size:11px; color:var(--ink-2); }
.tl-leg-sw { width:20px; height:5px; border-radius:2px; }

/* ============================================================
   CON_STORY
   ============================================================ */
.con_story { padding:100px 0 120px; background:var(--white); }
.con_story-inner { max-width:1160px; margin:0 auto; padding:0 40px; }

.story-shell {
  display:grid;
  grid-template-columns: 1fr 380px;
  gap:2px;
  min-height:560px;
  margin-bottom:48px;
}

.story-featured { position:relative; overflow:hidden; background:#0c0a08; }

.story-feat-item {
  position:absolute; inset:0;
  display:flex; flex-direction:column; justify-content:flex-end;
  opacity:0; transition:opacity .45s ease; pointer-events:none;
}
.story-feat-item.active { opacity:1; pointer-events:auto; }

.story-feat-bg {
  position:absolute; inset:0;
  background:var(--bg, #1a1a2a); transition:opacity .45s;
}
.story-feat-bg::after {
  content:''; position:absolute; inset:0;
  background:linear-gradient(to top, rgba(0,0,0,.82) 0%, rgba(0,0,0,.2) 55%, transparent 100%);
}
.story-feat-bg .ph-img { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; }

.story-feat-body { position:relative; z-index:2; padding:40px 44px 44px; }
.story-feat-cat { display:inline-flex; align-items:center; gap:7px; margin-bottom:12px; }
.story-feat-cat-dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; }
.story-feat-cat-label { font-size:10px; font-weight:700; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.7); }
.story-feat-title {
  font-family:var(--f-mincho); font-size:clamp(20px,2.2vw,30px);
  font-weight:700; line-height:1.3; letter-spacing:.03em;
  color:#fff; margin-bottom:14px; text-wrap:pretty;
}
.story-feat-desc { font-size:14px; line-height:1.85; color:rgba(255,255,255,.72); max-width:420px; text-wrap:pretty; margin-bottom:22px; }
.story-feat-meta { font-size:11px; color:rgba(255,255,255,.45); letter-spacing:.06em; margin-bottom:20px; }
.story-feat-link {
  display:inline-flex; align-items:center; gap:8px;
  font-size:13px; font-weight:600; letter-spacing:.06em;
  color:#fff; text-decoration:none;
  border-bottom:1px solid rgba(255,255,255,.45); padding-bottom:2px;
  width:fit-content; transition:gap .2s, border-color .2s;
}
.story-feat-link:hover { gap:14px; border-color:rgba(255,255,255,.9); }

.story-rail { display:flex; flex-direction:column; gap:2px; background:var(--paper-2); }
.story-thumb {
  position:relative; flex:1; display:flex; align-items:flex-end;
  overflow:hidden; cursor:pointer; background:#0c0a08;
  transition:flex .35s ease; min-height:0;
}
.story-thumb:hover { flex:1.7; }
.story-thumb.active { flex:1.7; }

.story-thumb-bg { position:absolute; inset:0; background:var(--bg, #1a1a2a); }
.story-thumb-bg .ph-img { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; opacity:.6; transition:opacity .3s; }
.story-thumb:hover .ph-img,
.story-thumb.active .ph-img { opacity:.85; }

.story-thumb-overlay { position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,.75) 0%, transparent 55%); transition:opacity .3s; }
.story-thumb::before {
  content:''; position:absolute; left:0; top:0; bottom:0; width:3px;
  background:var(--era-c, #fff); transform:scaleY(0); transform-origin:bottom;
  transition:transform .35s ease; z-index:5;
}
.story-thumb.active::before { transform:scaleY(1); }

.story-thumb-body { position:relative; z-index:2; padding:14px 16px; width:100%; }
.story-thumb-era { display:flex; align-items:center; gap:5px; margin-bottom:5px; }
.story-thumb-era-dot { width:5px; height:5px; border-radius:50%; }
.story-thumb-era-label { font-size:9px; letter-spacing:.14em; color:rgba(255,255,255,.55); }
.story-thumb-title { font-family:var(--f-mincho); font-size:13px; font-weight:700; color:#fff; line-height:1.35; text-wrap:pretty; }
.story-thumb-arrow { position:absolute; right:12px; top:50%; transform:translateY(-50%); font-size:16px; color:rgba(255,255,255,.5); opacity:0; transition:opacity .25s; z-index:3; }
.story-thumb.active .story-thumb-arrow { opacity:1; }

.story-more-wrap { text-align:center; padding-top:8px; }
.story-more {
  display:inline-flex; align-items:center; gap:10px;
  padding:14px 44px; border:1.5px solid var(--ink);
  font-size:13px; font-weight:500; letter-spacing:.1em;
  color:var(--ink); text-decoration:none; transition:background .2s, color .2s;
}
.story-more:hover { background:var(--ink); color:#fff; }
</style>

<!-- HERO -->
<section class="hero" aria-label="メインビジュアル">
  <div class="hero-mosaic">
    <div class="cell">
      <div class="hero-ph"><div class="hero-ph-label"><strong>吉野ヶ里遺跡</strong>弥生の環濠集落 · BC100</div></div>
    </div>
    <div class="cell">
      <div class="hero-ph"><div class="hero-ph-label"><strong>有田焼</strong>1616〜</div></div>
    </div>
    <div class="cell">
      <div class="hero-ph"><div class="hero-ph-label"><strong>築地反射炉</strong>1850</div></div>
    </div>
    <div class="cell">
      <div class="hero-ph"><div class="hero-ph-label"><strong>佐賀城</strong>1607〜</div></div>
    </div>
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-eyebrow">A Complete Biography of a Land</p>
    <h1 class="hero-title">
      <em>佐賀 — ある土地の伝記</em>
      大地の形成から、<br/>現代に至るまで。
    </h1>
    <p class="hero-sub">
      地質・縄文から江戸260年、幕末・明治まで。<br/>
      佐賀という土地の通史を、時代を横断して読む。
    </p>
    <a href="#con_about" class="hero-cta">
      佐賀藩を知る
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
    </a>
  </div>
  <div class="hero-scroll"><div class="scroll-line"></div><span>scroll</span></div>
</section>

<!-- CON_ABOUT -->
<section class="con_about scrollActive" id="con_about">
  <div class="con_about-inner">
    <div class="con_about-visual scrollActive">
      <div class="con_about-img-main">
        <div class="ph-img"><div class="ph-img-label"><strong>[ 佐賀城本丸御殿 ]</strong>写真を配置</div></div>
      </div>
      <div class="con_about-img-sub">
        <div class="ph-img"><div class="ph-img-label" style="font-size:10px; color:rgba(255,255,255,.6);">有田焼<br/>図版</div></div>
      </div>
    </div>
    <div class="con_about-text scrollActive">
      <p class="con_about-label">About Saga Han</p>
      <h2 class="con_about-title"><small>肥前国 · 外様大名</small>佐賀藩とは</h2>
      <div class="con_about-body">
        <p>佐賀藩（さがはん）は、肥前国佐賀郡（現在の佐賀県）を領した藩。藩庁は佐賀城。外様大名の鍋島氏が藩主を務め、石高は35万7千石。九州では薩摩藩・福岡藩に次ぐ規模を持った。</p>
        <p>地質の形成から縄文・弥生、古代国家の成立、少弐氏・龍造寺氏の台頭を経て江戸時代に花開いた260年。幕末には反射炉・海軍所を擁する雄藩として、明治維新に決定的な役割を果たした。</p>
        <p>このサイトでは、佐賀という土地の「完全な伝記」を、大地の形成（Layer 0）から現代（Layer 9）まで10の時代レイヤーで記述する。</p>
      </div>
      <div class="con_about-stats">
        <div class="stat"><div class="stat-num">35.7<sup>万石</sup></div><div class="stat-label">石高</div></div>
        <div class="stat"><div class="stat-num">260<sup>年</sup></div><div class="stat-label">藩政の期間</div></div>
        <div class="stat"><div class="stat-num">10</div><div class="stat-label">時代レイヤー</div></div>
      </div>
      <a href="#" class="btn-more">詳しく読む <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 7h10M8 3l4 4-4 4"/></svg></a>
    </div>
  </div>
</section>

<!-- CON_TIMELINE -->
<section class="con_timeline" id="timeline">
  <div class="timeline-wrap">
    <div class="section-head scrollActive">
      <span class="en">Historical Timeline</span>
      <h2>佐賀の通史年表</h2>
      <div class="section-rule"><div class="section-rule-dot"></div></div>
    </div>
    <div class="timeline-hint scrollActive">
      <span class="arrow">←</span><span>過去へスクロール — 今の佐賀市の地層を掘り下げる</span><span class="arrow">→</span>
    </div>
    <div class="timeline-scroll-area" id="tlScroll">
      <div class="timeline-stage">
        <div class="tl-edge left">BC 10,000 ←</div>
        <div class="tl-edge right">→ 現在</div>
        <div class="timeline-rail">
          <div class="rail-seg" style="--c:var(--c-geo);--w:2;opacity:.3"></div>
          <div class="rail-seg" style="--c:var(--c-yayoi);--w:20;background:linear-gradient(90deg,rgba(168,122,63,.35),rgba(180,140,70,.55))"></div>
          <div class="rail-seg" style="--c:var(--c-ancient);--w:8;opacity:.55"></div>
          <div class="rail-seg" style="--c:var(--c-medieval);--w:5"></div>
          <div class="rail-seg" style="--c:var(--c-ryuzoji);--w:5"></div>
          <div class="rail-seg" style="--c:var(--c-edo);--w:14;background:linear-gradient(90deg,#1f3052,#2a4070)"></div>
          <div class="rail-seg" style="--c:var(--c-bakumatsu);--w:4"></div>
          <div class="rail-seg" style="--c:var(--c-modern);--w:5"></div>
        </div>
