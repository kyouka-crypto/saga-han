---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 時代・主題のアクセント色を差し込む（例: 'var(--c-seiritsu)'） */
  eraColor?: string;
  /** 記事ページなら公開日・更新日（構造化データに使う） */
  published?: string;
  modified?: string;
}

const { title, description, eraColor, published, modified } = Astro.props;

const siteName = '佐賀藩アーカイブ';
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} | SAGA DOMAIN ARCHIVE`;
const desc =
  description ??
  '佐賀藩の制度・家臣団・財政・軍事・産業・学問を、出典を示しながら記述するアーカイブ。すべての記述に典拠を、未詳には未詳の表示を。';

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://saga-han.example.com').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': published ? 'Article' : 'WebSite',
  name: pageTitle,
  headline: title ?? siteName,
  description: desc,
  url: canonical,
  inLanguage: 'ja',
  isPartOf: { '@type': 'WebSite', name: siteName, url: Astro.site?.href },
  ...(published ? { datePublished: published } : {}),
  ...(modified ? { dateModified: modified } : {}),
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans+Condensed:wght@500;600&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      // FOUC 回避：描画前にテーマを確定する。あわせて JS 有効を示す印を付け、
      // 段階的強化（マトリクス・探索UI）が働くようにする。
      (function () {
        document.documentElement.classList.add('js');
        const apply = () => {
          const saved = localStorage.getItem('saga-theme');
          const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        };
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body style={eraColor ? `--era:${eraColor}` : undefined}>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // スクロール出現（reduced-motion では tokens/base 側で無効化）
      function initReveal() {
        const targets = document.querySelectorAll<HTMLElement>('.reveal:not(.is-visible)');
        if (!targets.length) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        targets.forEach((t) => io.observe(t));
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
